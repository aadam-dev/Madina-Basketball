# Supabase Configuration
# Madina project (open in the correct browser profile):
#   https://supabase.com/dashboard/project/nzquaqajqyhmlbfjivow/settings/api
# Then run scripts/APPLY_MADINA_OPS.sql in the SQL editor.
NEXT_PUBLIC_SUPABASE_URL=https://nzquaqajqyhmlbfjivow.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Admin Credentials
# Set secure passwords for admin accounts
ADMIN_EMAIL_1=admin1@example.com
ADMIN_PASSWORD_1=your_secure_password_1
ADMIN_EMAIL_2=admin2@example.com
ADMIN_PASSWORD_2=your_secure_password_2

# Optional: Bcrypt Hashed Passwords (Recommended for Production)
# Generate hashes using: node -e "const bcrypt = require('bcryptjs'); console.log(bcrypt.hashSync('your_password', 10))"
# ADMIN_PASSWORD_1_HASH=$2a$10$...
# ADMIN_PASSWORD_2_HASH=$2a$10$...

# Node Environment
# Automatically set by Vercel/Next.js, but you can override
# NODE_ENV=production

# Optional admin alerts. Forms still save if these are empty.
# WhatsApp: message the CallMeBot number once, then paste the phone and key.
# CALLMEBOT_PHONE=233559602056
# CALLMEBOT_APIKEY=
# Email via Resend. Use an address on a domain you have verified, or Resend's onboarding sender while testing.
# RESEND_API_KEY=
# RESEND_FROM=Madina Basketball <onboarding@resend.dev>
# NOTIFY_EMAIL=themadinacourt@gmail.com
#
# Vercel Cron (optional backup for Supabase keepalive). Set the same value in Vercel env.
# CRON_SECRET=generate-a-long-random-string
